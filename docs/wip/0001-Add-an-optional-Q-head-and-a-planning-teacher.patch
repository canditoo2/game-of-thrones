+def test_replay_buffer_refuses_to_mix_chosen_and_plain_examples() -> None:
+    from agot.engine.observation import ACTION_DIM, N_HOUSES, STATE_DIM
+
+    def example(chosen):
+        return Example(
+            state=np.zeros(STATE_DIM, dtype=np.float32),
